{
  "name": "fieldbook-server",
  "version": "0.1.0",
  "description": "Fieldbook MCP server: records debug builds on a phone, a simulator or this Mac.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "fieldbook-mcp": "src/main.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
